{
  "name": "crimson-court",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @court/server dev\" \"pnpm --filter @court/web dev\"",
    "build": "pnpm --filter @court/web build && pnpm --filter @court/server build && node -e \"require('fs').cpSync('apps/web/dist', 'dist', {recursive: true})\"",
    "build:vercel": "pnpm --filter @court/web build && node -e \"require('fs').cpSync('apps/web/dist', 'dist', {recursive: true})\"",
    "build:hosted": "node scripts/build-hosted.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "simulate": "tsx packages/engine/src/simulate.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
