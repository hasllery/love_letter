{
  "name": "@court/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:express --external:socket.io --external:zod --outfile=dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@court/engine": "workspace:*",
    "@court/shared": "workspace:*",
    "express": "^5.1.0",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.0"
  }
}
